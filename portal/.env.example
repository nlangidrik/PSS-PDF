# -----------------------------
# PSS PDF portal (.env.example)
# Copy to `.env` for Docker and `.env.local` for local dev.
# -----------------------------

# Public origin of this Next app, including the /portal base path.
NEXTAUTH_URL="https://pdf.pss.edu.mh/portal"

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me-with-a-generated-secret"

NODE_ENV="development"

# Docker Compose uses host `portal-db`. Local dev uses localhost:5435.
DATABASE_URL="postgresql://postgres:postgres@portal-db:5432/pss_pdf_portal"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="pss_pdf_portal"

# Exactly 32 characters. Encrypts the SMTP password at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0, 32))"
EMAIL_ENCRYPTION_KEY="change-this-key-to-32-chars!!!!!"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Workspace hosted domain. Sign-in fails closed when this is empty.
ALLOWED_GOOGLE_DOMAIN="pss.edu.mh"

# Used only by `pnpm db:seed`. The seed exits if this is unset.
ADMIN_SEED_PASSWORD="replace-with-a-seed-password"
